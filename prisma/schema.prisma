// Smart Hospital Connectivity - PostgreSQL Database Schema
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum PriorityLevel {
  NORMAL
  SENIOR_CITIZEN
  EMERGENCY
  PREGNANT_OR_DISABLED
}

enum TokenStatus {
  WAITING
  IN_CONSULTATION
  COMPLETED
  SKIPPED
  CANCELLED
}

enum VitalAlertStatus {
  STABLE
  WARNING
  CRITICAL
}

enum CounterCategory {
  OPD
  PHARMACY
  BILLING
  LABORATORY
  RADIOLOGY
  REGISTRATION
}

model Department {
  id                  String   @id @default(uuid())
  name                String   @unique
  code                String   @unique
  floor               String
  wing                String
  description         String?
  avgWaitTimeMinutes  Int      @default(15)
  activeQueueCount    Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  doctors             Doctor[]
  tokens              QueueToken[]
  locations           HospitalLocation[]
}

model Doctor {
  id                       String     @id @default(uuid())
  name                     String
  specialization           String
  roomNumber               String
  isAvailable              Boolean    @default(true)
  maxDailyPatients         Int        @default(30)
  currentTokenNumber       Int        @default(0)
  totalTokensIssued        Int        @default(0)
  avgConsultationTimeMins  Int        @default(10)
  shiftStart               String     @default("09:00 AM")
  shiftEnd                 String     @default("05:00 PM")
  departmentId             String
  department               Department @relation(fields: [departmentId], references: [id])
  activeNurseAssigned      String?

  tokens                   QueueToken[]
  appointments             Appointment[]
}

model Patient {
  id               String   @id @default(uuid())
  mrn              String   @unique
  name             String
  phone            String
  age              Int
  gender           String
  bloodGroup       String?
  emergencyContact String?
  createdAt        DateTime @default(now())

  tokens           QueueToken[]
  appointments     Appointment[]
  patientVitals    PatientVitals[]
  pharmacyOrders   PharmacyOrder[]
  billingBills     BillingInvoice[]
}

model QueueToken {
  id                   String        @id @default(uuid())
  tokenNumber          String
  sequenceNo           Int
  priority             PriorityLevel @default(NORMAL)
  status               TokenStatus   @default(WAITING)
  estimatedWaitMinutes Int
  issueTime            DateTime      @default(now())
  calledTime           DateTime?
  completedTime        DateTime?
  counterNumber        String?

  departmentId         String
  department           Department    @relation(fields: [departmentId], references: [id])
  doctorId             String
  doctor               Doctor        @relation(fields: [doctorId], references: [id])
  patientId            String
  patient              Patient       @relation(fields: [patientId], references: [id])
}

model Appointment {
  id              String   @id @default(uuid())
  appointmentDate DateTime
  timeSlot        String
  type            String   @default("OPD")
  status          String   @default("CONFIRMED")
  symptoms        String?
  
  patientId       String
  patient         Patient  @relation(fields: [patientId], references: [id])
  doctorId        String
  doctor          Doctor   @relation(fields: [doctorId], references: [id])
}

model PatientVitals {
  id            String           @id @default(uuid())
  bedNumber     String
  ward          String
  heartRate     Int
  bpSystolic    Int
  bpDiastolic   Int
  spO2          Int
  temperature   Float
  alertStatus   VitalAlertStatus @default(STABLE)
  nurseAssigned String
  lastUpdated   DateTime         @default(now())

  patientId     String
  patient       Patient          @relation(fields: [patientId], references: [id])
}

model HospitalLocation {
  id             String          @id @default(uuid())
  name           String
  category       CounterCategory
  floor          String
  wing           String
  directionSteps String
  queueWaitMins  Int             @default(5)

  departmentId   String?
  department     Department?     @relation(fields: [departmentId], references: [id])
}

model PharmacyOrder {
  id              String   @id @default(uuid())
  orderNumber     String   @unique
  prescribedBy    String
  itemsCount      Int
  status          String   @default("PREPARING")
  pickupCounter   String   @default("Counter #2")
  createdAt       DateTime @default(now())

  patientId       String
  patient         Patient  @relation(fields: [patientId], references: [id])
}

model BillingInvoice {
  id            String   @id @default(uuid())
  invoiceNumber String   @unique
  serviceType   String
  amount        Float
  status        String   @default("PENDING")
  paymentMethod String?
  dueDate       DateTime @default(now())

  patientId     String
  patient       Patient  @relation(fields: [patientId], references: [id])
}
